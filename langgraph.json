{
  "$schema": "https://langgra.ph/schema.json",
  "dependencies": [
    "."
  ],
  "graphs": {
    "finance_agent": "./financeclaw/agent_server/graphs/product.py:finance_agent"
  },
  "env": ".env",
  "python_version": "3.13",
  "store": {
    "index": {
      "embed": "./financeclaw/agent_server/memory/embeddings.py:embeddings",
      "dims": 1536,
      "fields": [
        "content"
      ]
    }
  },
  "http": {
    "app": "./financeclaw/api/bootstrap.py:app"
  },
  "auth": {
    "path": "./financeclaw/api/native_auth.py:auth"
  }
}
