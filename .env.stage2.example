# Copy to .env. Never commit real credentials.
# Production must use PostgreSQL and run Alembic migrations before application startup.
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_MODEL=openai:deepseek-v4-pro
FINANCECLAW_FALLBACK_MODELS=[]
FINANCECLAW_PROVIDER_BASE_URL=https://api.deepseek.com
FINANCECLAW_PROVIDER_API_KEY=
FINANCECLAW_OFFLINE_MODEL=false
FINANCECLAW_DEBUG_FULL_IO=true
FINANCECLAW_AGENT_SERVER_URL=http://127.0.0.1:2024
FINANCECLAW_AGENT_SERVER_SERVICE_TOKEN=
FINANCECLAW_BFF_AUTH_TOKEN=
FINANCECLAW_BFF_TENANT_ID=development
FINANCECLAW_BFF_SUBJECT_ID=developer
FINANCECLAW_BFF_SCOPES=["market:read","tools:read","watchlist:write","artifacts:read"]

FINANCECLAW_DATABASE_URL=sqlite+pysqlite:///./.financeclaw/financeclaw.db
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=true
FINANCECLAW_ARTIFACT_ROOT=.financeclaw/artifacts
FINANCECLAW_ARTIFACT_INLINE_BYTES=16384

FINANCECLAW_CONTEXT_INPUT_LIMIT=32768
FINANCECLAW_CONTEXT_RESERVED_OUTPUT=4096
FINANCECLAW_CONTEXT_SYSTEM_POLICY_RESERVE=2048
FINANCECLAW_CONTEXT_TOOL_SCHEMA_RESERVE=4096
FINANCECLAW_CONTEXT_SAFETY_MARGIN=1024
FINANCECLAW_SUMMARY_SEGMENT_MESSAGES=12
FINANCECLAW_SUMMARY_HIERARCHY_SEGMENTS=8

LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financeclaw-stage2-development
