# Non-secret settings only. Generate local credentials with scripts/init-local.py.
FINANCECLAW_HTTP_PORT=8080
FINANCECLAW_TENANT=local
FINANCECLAW_SUBJECT=developer
FINANCECLAW_MODEL=offline
FINANCECLAW_MODEL_BASE_URL=
FINANCECLAW_MODEL_THINKING=false
# Conservative UTF-8 byte budgets; current input and tool results share the work-context budget.
FINANCECLAW_CONTEXT_SYSTEM_BYTES=8192
FINANCECLAW_CONTEXT_LONG_MEMORY_BYTES=16384
FINANCECLAW_CONTEXT_WORK_CONTEXT_BYTES=24576
FINANCECLAW_CONTEXT_CURRENT_INPUT_BYTES=8192
FINANCECLAW_CONTEXT_TOOL_SCHEMA_BYTES=49152
FINANCECLAW_CONTEXT_TOOL_RESULT_BYTES=8192
FINANCECLAW_CONTEXT_SUMMARY_BYTES=2048
FINANCECLAW_CONTEXT_COMPACT_AT_PERCENT=80
FINANCECLAW_CONTEXT_RETAINED_ROUNDS=1
# Ziwei remains development-only until live model acceptance is reviewed.
FINANCECLAW_ZIWEI_ENABLED=false
FINANCECLAW_ZIWEI_DEVELOPMENT=false
FINANCECLAW_ZIWEI_KEY_VERSION=dev-v1
FINANCECLAW_ZIWEI_QUERY_TIMEZONE=Asia/Shanghai
FINANCECLAW_HOTEL_ENABLED=false
FINANCECLAW_HOTEL_URL=https://mcp.rollinggo.cn/mcp
FINANCECLAW_HOTEL_ALLOWED_HOSTS=mcp.rollinggo.cn
FINANCECLAW_TAIBU_ENABLED=false
FINANCECLAW_TAIBU_URL=
FINANCECLAW_TAIBU_ALLOWED_HOSTS=
FINANCECLAW_MEMORY_ENABLED=false
FINANCECLAW_PROFILE_ENABLED=true
# 直接运行 JVM 时使用的服务器画像目录；Compose 目录模式使用 compose.profile.yml。
FINANCECLAW_PROFILE_DIRECTORY=
FINANCECLAW_PROFILE_HOST_DIRECTORY=./server/profiles
FINANCECLAW_MEMORY_VECTOR_SEARCH=false
# Optional independent ledger: bootstrap first; Compose uses compose.forget-ledger.yml.
# Supply its password through .secrets/forget-ledger-password or secret management.
FINANCECLAW_FORGET_LEDGER_ENABLED=false
FINANCECLAW_FORGET_LEDGER_URL=
FINANCECLAW_FORGET_LEDGER_USER=
FINANCECLAW_MEMORY_MODEL=
FINANCECLAW_MEMORY_MODEL_BASE_URL=
FINANCECLAW_EMBEDDING_MODEL=
FINANCECLAW_EMBEDDING_BASE_URL=
FINANCECLAW_EMBEDDING_REVISION=local-no-embedding-v1
FINANCECLAW_FEISHU_ENABLED=false
FINANCECLAW_FEISHU_APP_ID=
FINANCECLAW_FEISHU_TENANT_KEY=
