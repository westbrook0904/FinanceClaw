+def test_message_projection_matches_pinned_openai_request_without_mutation():
+    """与真实 adapter 的发送载荷对照，覆盖内容块、有效/无效/旧式调用和 kwargs。"""
+    messages = [
+        SystemMessage(content="policy", additional_kwargs={"__openai_role__": "developer"}),
+        HumanMessage(
+            content=[
+                {"type": "text", "text": "图片问题"},
+                {"type": "image_url", "image_url": {"url": "data:image/png;base64,AAAA"}},
+            ],
+            additional_kwargs={"name": "reader", "financeclaw_source": {"sequence": 1}},
+        ),
+        AIMessage(
+            content="",
+            tool_calls=[{"id": "valid", "name": "lookup", "args": {"city": "上海"}}],
+            invalid_tool_calls=[{"id": "invalid", "name": "lookup", "args": "{broken"}],
+        ),
+        ToolMessage(content=[{"type": "text", "text": "result"}], tool_call_id="valid"),
+        AIMessage(
+            content="",
+            additional_kwargs={
+                "tool_calls": [
+                    {
+                        "id": "raw",
+                        "type": "function",
+                        "function": {"name": "lookup", "arguments": "{broken"},
+                        "local": "omit",
+                    }
+                ]
+            },
+        ),
+        AIMessage(
+            content="", additional_kwargs={"function_call": {"name": "old", "arguments": "{}"}}
+        ),
+        FunctionMessage(content="legacy result", name="old"),
+        AIMessage(content="", additional_kwargs={"audio": {"id": "audio-1", "data": "local"}}),
+    ]
+    before = deepcopy(messages)
+    model = ChatOpenAI(model="gpt-4o", api_key="synthetic-test-key", use_responses_api=False)
+    expected = model._get_request_payload(messages)["messages"]
+    projected = request_payload(messages)["messages"]
+    assert projected == expected
+    assert projected[2]["tool_calls"][0]["function"]["arguments"]
+    assert projected[4]["tool_calls"][0]["function"]["arguments"] == "{broken"
+    assert projected[5]["function_call"]["name"] == "old"
+    assert projected[7]["audio"] == {"id": "audio-1"}
+    assert messages == before
+    counter = TokenCounter("utf8-bytes-v1")
+    for message, payload in zip(messages, projected, strict=True):
+        assert counter.message(message) == 4 + len(
+            json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")
+        )
+
+
