+def test_local_artifact_and_provenance_do_not_change_visible_cost(monkeypatch):
+    """巨型本地数据不影响两种计量入口，也不被序列化投影修改或丢弃。"""
+    monkeypatch.setenv("TIKTOKEN_CACHE_DIR", "")
+    counter = TokenCounter()
+    planner = ContextBudgetPlanner(profile(context_window_tokens=5000, max_tokens=1000), 6000)
+    plain = ToolMessage(content="相同可见结果", tool_call_id="lookup-1")
+    observed = plain.model_copy(
+        update={
+            "artifact": {"raw": "原始工件" * 100_000},
+            "additional_kwargs": {
+                "artifact_ref": {"artifact_id": "local-ref", "preview": "引用" * 10_000},
+                "financeclaw_source": {"source": "来源" * 10_000},
+                "financeclaw_memory_omissions": [{"reason": "budget"}] * 1000,
+            },
+            "response_metadata": {"trace": "本地诊断" * 10_000},
+        }
+    )
+    before = observed.model_dump()
+    assert counter.estimator_id == planner.estimator_id == "utf8-bytes-v1"
+    assert counter.message(observed) == counter.message(plain)
+    assert planner.check([observed]) == planner.check([plain])
+    assert request_payload([observed]) == request_payload([plain])
+    assert observed.model_dump() == before
+
