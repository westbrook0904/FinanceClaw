+def test_request_schemas_and_settings_still_consume_budget():
+    """工具定义、输出 schema 与模型设置留在整请求计量中。"""
+    planner = ContextBudgetPlanner(
+        profile(context_window_tokens=5000, max_tokens=1000, token_estimator="utf8-bytes-v1"),
+        6000,
+    )
+    schema = {
+        "type": "object",
+        "properties": {"query": {"type": "string", "description": "字段" * 1000}},
+    }
+    tool = {"type": "function", "function": {"name": "lookup", "parameters": schema}}
+    for options in (
+        {"tools": [tool]},
+        {"output_schema": schema},
+        {"model_settings": {"extra_body": {"instruction": "设置" * 1000}}},
+    ):
+        with pytest.raises(ValueError, match="input budget"):
+            planner.check([HumanMessage(content="small")], **options)
