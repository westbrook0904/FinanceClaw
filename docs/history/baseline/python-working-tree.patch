+def test_visible_message_fields_still_consume_hard_budget(message):
+    """正文、系统、工具参数及内容块都不能因移除本地元数据而逃过硬预算。"""
+    planner = ContextBudgetPlanner(
+        profile(context_window_tokens=5000, max_tokens=1000, token_estimator="utf8-bytes-v1"),
+        6000,
+    )
+    assert planner.counter.message(message) > planner.input_limit
+    with pytest.raises(ValueError, match="input budget"):
+        planner.check([message])
+
