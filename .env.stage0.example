# Real Provider/LangSmith mode (never commit actual values).
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financeclaw-stage0-development

# Agent graph settings.
FINANCECLAW_SPIKE_ENVIRONMENT=development
FINANCECLAW_SPIKE_MODEL=openai:gpt-5.4-mini
FINANCECLAW_SPIKE_OFFLINE_MODEL=false
FINANCECLAW_SPIKE_DEBUG_FULL_IO=true

# Optional service integration probes.
FINANCECLAW_SPIKE_POSTGRES_DSN=postgresql://financeclaw:financeclaw@localhost:5432/financeclaw_agent
FINANCECLAW_SPIKE_REDIS_URL=redis://localhost:6379/0
