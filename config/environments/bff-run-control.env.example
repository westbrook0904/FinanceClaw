# BFF run control. BFF and Agent Server retain the same business database and release configuration.
FINANCECLAW_BFF_BACKEND_INSTANCE_ID=langgraph-main
FINANCECLAW_BFF_CALLBACK_URL=https://bff.internal/internal/webhooks/langgraph/langgraph-main
FINANCECLAW_BFF_WEBHOOK_TOKEN=
FINANCECLAW_INTERNAL_SERVICE_HOSTS=["127.0.0.1","localhost","agent-server","bff.internal"]
FINANCECLAW_BFF_APPROVAL_SCOPE=tools:approve
FINANCECLAW_BFF_RUN_POLL_SECONDS=1
FINANCECLAW_BFF_RUN_RECONCILE_SECONDS=10
FINANCECLAW_BFF_RUN_LEASE_SECONDS=60
FINANCECLAW_BFF_RUN_MAX_STEP_SECONDS=120
FINANCECLAW_BFF_RUN_CONCURRENCY=4
FINANCECLAW_BFF_RUN_GRANT_SECONDS=1800
FINANCECLAW_BFF_RUN_READY_BACKLOG_SECONDS=120
# Apply 0001_initial to an empty application database, then open BFF admission with run_control.
# Agent Server uses langgraph.json; inject LG_WEBHOOK_BFF_TOKEN with the same callback secret.
# Notification sender configuration remains independent.
