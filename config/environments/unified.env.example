# Copy to .env. This local profile uses fresh financeclaw-stage10 volumes.
POSTGRES_PASSWORD=replace-with-a-local-database-password
API_PORT=8000
WORKER_JOBS=4
# Official AgentServer self-hosting credential; inject a valid key or license.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGGRAPH_API_DO_NOT_TRACK=true
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_OFFLINE_MODEL=true
FINANCECLAW_API_AUTH_TOKEN=replace-with-a-local-product-token
FINANCECLAW_API_TENANT_ID=local
FINANCECLAW_API_SUBJECT_ID=local
FINANCECLAW_INTEGRATION_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-bytes
FINANCECLAW_ARTIFACT_BACKEND=local
FINANCECLAW_ZIWEI_ENABLED=false
FINANCECLAW_FEISHU_ENABLED=false
# API/worker/integrations role and persistence URLs are set by compose.yml.
# Real models: disable OFFLINE_MODEL and configure the provider profile.
# Production: use production.env.example OIDC, S3 encryption and telemetry settings.
