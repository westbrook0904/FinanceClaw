# Copy to .env. This local profile uses fresh financeclaw-stage11 volumes.
POSTGRES_PASSWORD=replace-with-a-local-database-password
MEMORY_POSTGRES_PASSWORD=replace-with-a-separate-memory-database-password
API_PORT=8000
WORKER_JOBS=4
# Official AgentServer self-hosting credential; inject a valid key or license.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGGRAPH_API_DO_NOT_TRACK=true
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_OFFLINE_MODEL=true
FINANCECLAW_API_AUTH_TOKEN=replace-with-a-local-product-token
FINANCECLAW_API_TENANT_ID=local
FINANCECLAW_API_SUBJECT_ID=local
FINANCECLAW_INTEGRATION_SERVICE_TOKEN=replace-with-a-random-service-token-at-least-32-bytes
FINANCECLAW_ARTIFACT_BACKEND=local
# For host S3/MinIO, set this to '["api","host.docker.internal"]'.
FINANCECLAW_INTERNAL_SERVICE_HOSTS='["api"]'
FINANCECLAW_ZIWEI_ENABLED=false
FINANCECLAW_FEISHU_ENABLED=false
# API/worker/integrations/memory_worker role and persistence URLs are set by compose.yml.
# Real models: disable OFFLINE_MODEL and configure the provider profile.
# Production: use production.env.example OIDC, S3 encryption and telemetry settings.

# Taibu MCP: opt in with compose.taibu.yml; see docs/operations/taibu-mcp.md.
FINANCECLAW_TAIBU_ENABLED=false
FINANCECLAW_TAIBU_MCP_URL=http://taibu-mcp:3001/mcp
FINANCECLAW_TAIBU_EGRESS=internal
FINANCECLAW_TAIBU_ALLOWED_HOSTS='["taibu-mcp"]'
FINANCECLAW_TAIBU_ALLOWED_TOOLS='["almanac","bazi"]'
FINANCECLAW_TAIBU_TIMEOUT_SECONDS=10
FINANCECLAW_TAIBU_PROJECTION_BYTES=8192
FINANCECLAW_TAIBU_RESULT_MAX_BYTES=262144
FINANCECLAW_TAIBU_CONTRACT_CACHE_SECONDS=300
# Optional tenant restriction: FINANCECLAW_TAIBU_TENANT_ALLOWLIST='["your-tenant"]'
# Enabling bazi also requires DEBUG_FULL_IO=false and LANGSMITH_HIDE_INPUTS/OUTPUTS=true.
# Append "taibu:read" to authorized API/Feishu scopes; keep "artifacts:read" for history.
# Production OIDC grants scopes through the identity provider; never add wildcard access.

# Stage 11: API/worker must share these published policy values.
FINANCECLAW_PROCESSING_REGION=global
FINANCECLAW_MEMORY_ENABLED=true
FINANCECLAW_MEMORY_AUTO_EXTRACT=true
FINANCECLAW_MEMORY_PERMIT_SECONDS=86400
FINANCECLAW_MEMORY_CANDIDATE_SECONDS=604800
FINANCECLAW_MEMORY_INDEX_VERSION=memory-v1
FINANCECLAW_MEMORY_EXTRACTION_CONCURRENCY=2
FINANCECLAW_MEMORY_CONSOLIDATION_CONCURRENCY=1
FINANCECLAW_MEMORY_WORKER_LEASE_SECONDS=120
FINANCECLAW_MEMORY_WORKER_RENEW_SECONDS=20
FINANCECLAW_MEMORY_MODEL_ALLOWED_DATA_CLASSES='["public","internal","confidential","restricted"]'
FINANCECLAW_MEMORY_MODEL_ALLOWED_REGIONS='["global"]'
# Optional dedicated models must match the memory worker profile exactly.
FINANCECLAW_MODEL_CONFIG_PATH=config/models.toml
# Generic read-only MCP and optional RollingGo; import contracts before enabling servers.
# See docs/operations/mcp.md for scopes and task data classification.
FINANCECLAW_MCP_CONFIG_PATH=config/mcp.toml
# FINANCECLAW_ROLLINGGO_API_KEY=provided-by-secret-manager
# Real model keys: inject only providers used by this process.
# FINANCECLAW_QWEN_API_KEY=provided-by-secret-manager
# FINANCECLAW_DEEPSEEK_API_KEY=provided-by-secret-manager
