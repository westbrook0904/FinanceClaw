# Copy to the repository root as .env.bff.local and replace both secret placeholders.
# This profile is for a BFF process running on the host machine.
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_DEBUG_FULL_IO=true
FINANCECLAW_LOG_LEVEL=INFO
FINANCECLAW_OFFLINE_MODEL=false
FINANCECLAW_MODEL=openai:deepseek-v4-pro
FINANCECLAW_PROVIDER_BASE_URL=https://api.deepseek.com
FINANCECLAW_PROVIDER_API_KEY=replace-with-deepseek-api-key
FINANCECLAW_EGRESS_ALLOWED_HOSTS='["api.deepseek.com","api.smith.langchain.com"]'

FINANCECLAW_BFF_AUTH_TOKEN=local-only-token
FINANCECLAW_BFF_TENANT_ID=local-development
FINANCECLAW_BFF_SUBJECT_ID=local-developer
FINANCECLAW_AGENT_SERVER_URL=http://127.0.0.1:2024
FINANCECLAW_INTERNAL_SERVICE_HOSTS='["127.0.0.1","localhost"]'
# Keep local dependency traffic out of a developer machine's HTTP(S) proxy.
NO_PROXY=127.0.0.1,localhost,host.docker.internal
no_proxy=127.0.0.1,localhost,host.docker.internal

FINANCECLAW_DATABASE_URL=postgresql+psycopg://financeclaw:financeclaw-local@127.0.0.1:5432/financeclaw_app
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=false

FINANCECLAW_ARTIFACT_BACKEND=s3
FINANCECLAW_ARTIFACT_S3_BUCKET=financeclaw-artifacts
FINANCECLAW_ARTIFACT_S3_PREFIX=local
FINANCECLAW_ARTIFACT_S3_ENDPOINT_URL=http://127.0.0.1:9000
FINANCECLAW_ARTIFACT_S3_REGION=us-east-1
FINANCECLAW_ARTIFACT_S3_SSE_ALGORITHM=AES256
AWS_ACCESS_KEY_ID=financeclaw
AWS_SECRET_ACCESS_KEY=financeclaw-local-minio
AWS_DEFAULT_REGION=us-east-1

# Raw LANGSMITH_* variables enable SDK tracing. FINANCECLAW_LANGSMITH_* configures
# the BFF's observability adapter; keep both sets aligned.
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financeclaw-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
FINANCECLAW_LANGSMITH_PROJECT=financeclaw-local
FINANCECLAW_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=1.0
FINANCECLAW_LANGSMITH_HIDE_INPUTS=false
FINANCECLAW_LANGSMITH_HIDE_OUTPUTS=false

# Only required when one LangSmith API key can access multiple workspaces.
# LANGSMITH_WORKSPACE_ID=replace-with-workspace-id

# DeepSeek V4 Pro 1M context: 800K planning ceiling, including output and input reserves.
FINANCECLAW_CONTEXT_INPUT_LIMIT=800000
FINANCECLAW_MODEL_MAX_TOKENS=32768
FINANCECLAW_MODEL_TIMEOUT_SECONDS=300
FINANCECLAW_CONTEXT_RESERVED_OUTPUT=32768
FINANCECLAW_CONTEXT_SYSTEM_POLICY_RESERVE=8192
FINANCECLAW_CONTEXT_TOOL_SCHEMA_RESERVE=32768
FINANCECLAW_CONTEXT_SAFETY_MARGIN=32768

# Stage 9：原生 state 摘要、工具结果归档和 Store 记忆。
FINANCECLAW_CONTEXT_RECENT_TURNS=4
FINANCECLAW_CONTEXT_SUMMARY_TRIGGER_TOKENS=64000
FINANCECLAW_CONTEXT_SOFT_INPUT_TOKENS=96000
FINANCECLAW_CONTEXT_TOOL_RESULTS_TO_KEEP=3
FINANCECLAW_SUMMARY_MAX_TOKENS=4096
FINANCECLAW_MEMORY_RECALL_TOKENS=4096
FINANCECLAW_MEMORY_RECALL_LIMIT=6
FINANCECLAW_MEMORY_AUTO_COMMIT_LOW_RISK_PREFERENCES=true
FINANCECLAW_ARTIFACT_RETENTION_DAYS=30
FINANCECLAW_EMBEDDING_DIMENSIONS=1536
FINANCECLAW_EMBEDDING_TIMEOUT_SECONDS=30
FINANCECLAW_HISTORY_INDEX_VERSION=history/1
FINANCECLAW_HISTORY_INDEX_BATCH_SIZE=4
FINANCECLAW_HISTORY_INDEX_POLL_SECONDS=5
# 按所选真实服务填写，并同步 langgraph*.json 中的 store.index.dims。
# FINANCECLAW_EMBEDDING_MODEL=provider-model
# FINANCECLAW_EMBEDDING_BASE_URL=https://provider.example/v1
# FINANCECLAW_EMBEDDING_API_KEY=provided-by-secret-manager
# FINANCECLAW_SUMMARY_MODEL=openai:summary-model
