FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_DEBUG_FULL_IO=true
FINANCECLAW_OFFLINE_MODEL=true
FINANCECLAW_BFF_AUTH_TOKEN=local-only-token
FINANCECLAW_DATABASE_URL=sqlite+pysqlite:///./.financeclaw/development.db
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=true
FINANCECLAW_ARTIFACT_BACKEND=local
FINANCECLAW_LANGSMITH_PROJECT=financeclaw-development
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=1.0
FINANCECLAW_FEISHU_ENABLED=false
FINANCECLAW_FEISHU_APP_ID=
FINANCECLAW_FEISHU_APP_SECRET=
FINANCECLAW_FEISHU_ALLOWED_OPEN_IDS='[]'
FINANCECLAW_FEISHU_SCOPES='["market:read","tools:read","artifacts:read","memory:read"]'
FINANCECLAW_FEISHU_MAX_CONCURRENCY=8
FINANCECLAW_FEISHU_SECURITY_MODE=audit
