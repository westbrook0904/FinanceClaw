# Copy to the repository root as .env.agent-server.local and replace both secrets.
# LangGraph `up` runs the Agent Server in Docker, so host services use
# host.docker.internal rather than 127.0.0.1.
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_DEBUG_FULL_IO=true
FINANCECLAW_LOG_LEVEL=INFO
FINANCECLAW_OFFLINE_MODEL=false
FINANCECLAW_MODEL=openai:deepseek-v4-pro
FINANCECLAW_PROVIDER_BASE_URL=https://api.deepseek.com
FINANCECLAW_PROVIDER_API_KEY=replace-with-deepseek-api-key
FINANCECLAW_EGRESS_ALLOWED_HOSTS='["api.deepseek.com","api.smith.langchain.com"]'
FINANCECLAW_INTERNAL_SERVICE_HOSTS='["127.0.0.1","localhost","host.docker.internal"]'
NO_PROXY=127.0.0.1,localhost,host.docker.internal
no_proxy=127.0.0.1,localhost,host.docker.internal

# Graph-side business repositories use financeclaw_app. The Agent Server's own
# thread/run/checkpoint/store database is supplied separately via --postgres-uri.
FINANCECLAW_DATABASE_URL=postgresql+psycopg://financeclaw:financeclaw-local@host.docker.internal:5432/financeclaw_app
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=false

FINANCECLAW_ARTIFACT_BACKEND=s3
FINANCECLAW_ARTIFACT_S3_BUCKET=financeclaw-artifacts
FINANCECLAW_ARTIFACT_S3_PREFIX=local
FINANCECLAW_ARTIFACT_S3_ENDPOINT_URL=http://host.docker.internal:9000
FINANCECLAW_ARTIFACT_S3_REGION=us-east-1
FINANCECLAW_ARTIFACT_S3_SSE_ALGORITHM=AES256
AWS_ACCESS_KEY_ID=financeclaw
AWS_SECRET_ACCESS_KEY=financeclaw-local-minio
AWS_DEFAULT_REGION=us-east-1

LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financeclaw-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
FINANCECLAW_LANGSMITH_PROJECT=financeclaw-local
FINANCECLAW_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=1.0
FINANCECLAW_LANGSMITH_HIDE_INPUTS=false
FINANCECLAW_LANGSMITH_HIDE_OUTPUTS=false

# Only required when one LangSmith API key can access multiple workspaces.
# LANGSMITH_WORKSPACE_ID=replace-with-workspace-id

# DeepSeek V4 Pro 1M context: 800K planning ceiling, including output and input reserves.
FINANCECLAW_CONTEXT_INPUT_LIMIT=800000
FINANCECLAW_MODEL_MAX_TOKENS=32768
FINANCECLAW_MODEL_TIMEOUT_SECONDS=300
FINANCECLAW_CONTEXT_RESERVED_OUTPUT=32768
FINANCECLAW_CONTEXT_SYSTEM_POLICY_RESERVE=8192
FINANCECLAW_CONTEXT_TOOL_SCHEMA_RESERVE=32768
FINANCECLAW_CONTEXT_SAFETY_MARGIN=32768
FINANCECLAW_CONTEXT_RECENT_MESSAGES=64
FINANCECLAW_CONTEXT_RELEVANT_MESSAGES=16
FINANCECLAW_CONTEXT_RELEVANT_SUMMARIES=8
