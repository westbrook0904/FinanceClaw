# 在选定环境 profile 之上叠加；BFF、Ingress、Worker 连接同一应用数据库。
# 真实 secret 由部署系统注入，不提交 .env.coordinator。
FINANCECLAW_COORDINATOR_ENABLED=true
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=false
FINANCECLAW_COORDINATOR_BACKEND_INSTANCE_ID=langgraph-primary
FINANCECLAW_COORDINATOR_CALLBACK_URL=https://coordinator-ingress.internal/internal/webhooks/langgraph-primary
FINANCECLAW_COORDINATOR_WEBHOOK_TOKEN=
FINANCECLAW_COORDINATOR_GRANT_SECONDS=1800
FINANCECLAW_COORDINATOR_APPROVAL_SCOPE=tools:approve
FINANCECLAW_COORDINATOR_POLL_SECONDS=1
FINANCECLAW_COORDINATOR_RECONCILE_SECONDS=10
FINANCECLAW_COORDINATOR_LEASE_SECONDS=60
FINANCECLAW_COORDINATOR_MAX_STEP_SECONDS=120
# 同一 backend 的所有 Worker 使用相同 global/tenant 配额；进程槽位各自有界。
FINANCECLAW_COORDINATOR_WORKER_CONCURRENCY=4
FINANCECLAW_COORDINATOR_MAX_INFLIGHT=32
FINANCECLAW_COORDINATOR_TENANT_INFLIGHT=4
FINANCECLAW_COORDINATOR_READY_BACKLOG_SECONDS=120
# ENABLED=false 只关闭新受理，不恢复 GET 驱动；暂停现有派发使用部署 CAS CLI。
# DATABASE_URL、AGENT_SERVER_URL、AGENT_SERVER_SERVICE_TOKEN、Artifact 配置沿用环境 profile。
# Agent Server 单独注入 LG_WEBHOOK_COORDINATOR_TOKEN，值须与 Ingress 的 token 一致。
