# Copy to .env.memory. This file is used only by the memory_worker container.
# Match MEMORY_POSTGRES_PASSWORD in .env; use a separate secret in deployment.
MEMORY_POSTGRES_PASSWORD=replace-with-a-separate-memory-database-password
FINANCECLAW_ENVIRONMENT=development
FINANCECLAW_OFFLINE_MODEL=true
FINANCECLAW_DEBUG_FULL_IO=false
FINANCECLAW_OTEL_SERVICE_NAME=financeclaw-memory-worker
FINANCECLAW_PROCESSING_REGION=global
FINANCECLAW_MEMORY_ENABLED=true
FINANCECLAW_MEMORY_AUTO_EXTRACT=true
FINANCECLAW_MEMORY_AUTO_COMMIT_LOW_RISK_PREFERENCES=true
FINANCECLAW_MEMORY_CANDIDATE_SECONDS=604800
FINANCECLAW_MEMORY_EXTRACTION_CONCURRENCY=2
FINANCECLAW_MEMORY_CONSOLIDATION_CONCURRENCY=1
FINANCECLAW_MEMORY_WORKER_LEASE_SECONDS=120
FINANCECLAW_MEMORY_WORKER_RENEW_SECONDS=20
FINANCECLAW_MEMORY_MODEL_ALLOWED_DATA_CLASSES='["public","internal","confidential","restricted"]'
FINANCECLAW_MEMORY_MODEL_ALLOWED_REGIONS='["global"]'
# Never copy product, OIDC, integrations or native Store credentials into this file.
# FINANCECLAW_OFFLINE_MODEL=false
# FINANCECLAW_EGRESS_ALLOWED_HOSTS='["provider.example"]'
# Production also requires PostgreSQL with schema creation disabled, hidden traces
# and actual trace/metric endpoints. No product OIDC, S3 or integrations secret is needed.
FINANCECLAW_LANGSMITH_HIDE_INPUTS=true
FINANCECLAW_LANGSMITH_HIDE_OUTPUTS=true
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=0.1
# FINANCECLAW_OTEL_EXPORTER_ENDPOINT=https://telemetry.example/v1/traces
# FINANCECLAW_OTEL_METRICS_EXPORTER_ENDPOINT=https://telemetry.example/v1/metrics
LANGSMITH_TRACING=false
FINANCECLAW_MODEL_CONFIG_PATH=config/models.toml
# Real model keys: inject only providers used by this process.
# FINANCECLAW_QWEN_API_KEY=provided-by-secret-manager
# FINANCECLAW_DEEPSEEK_API_KEY=provided-by-secret-manager
