# Values are placeholders only; deployment automation resolves all secrets.
FINANCECLAW_ENVIRONMENT=production
FINANCECLAW_DEBUG_FULL_IO=false
FINANCECLAW_OFFLINE_MODEL=false
FINANCECLAW_MODEL=openai:deepseek-v4-pro
FINANCECLAW_PROVIDER_BASE_URL=https://api.deepseek.com
FINANCECLAW_PROVIDER_API_KEY=<secret-manager-reference>
FINANCECLAW_OIDC_ISSUER=https://id.example.com/
FINANCECLAW_OIDC_AUDIENCE=financeclaw-api
FINANCECLAW_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
FINANCECLAW_OIDC_ALGORITHMS='["RS256"]'
FINANCECLAW_AGENT_SERVER_URL=http://agent-server:2024
FINANCECLAW_AGENT_SERVER_SERVICE_TOKEN=<secret-manager-reference>
FINANCECLAW_DATABASE_URL=postgresql+psycopg://financeclaw:<secret>@app-db/financeclaw_app
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=false
FINANCECLAW_ARTIFACT_BACKEND=s3
FINANCECLAW_ARTIFACT_S3_BUCKET=financeclaw-artifacts
FINANCECLAW_ARTIFACT_S3_ENDPOINT_URL=http://artifact-store:9000
FINANCECLAW_ARTIFACT_S3_SSE_ALGORITHM=AES256
FINANCECLAW_LANGSMITH_PROJECT=financeclaw-production
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=0.05
FINANCECLAW_LANGSMITH_HIDE_INPUTS=true
FINANCECLAW_LANGSMITH_HIDE_OUTPUTS=true
FINANCECLAW_OTEL_EXPORTER_ENDPOINT=https://otel-collector.example.com/v1/traces
FINANCECLAW_OTEL_METRICS_EXPORTER_ENDPOINT=https://otel-collector.example.com/v1/metrics
FINANCECLAW_OTEL_TRACE_SAMPLE_RATE=0.1
FINANCECLAW_EGRESS_ALLOWED_HOSTS='["api.deepseek.com","id.example.com","api.smith.langchain.com","otel-collector.example.com"]'
FINANCECLAW_FEISHU_ENABLED=false
FINANCECLAW_FEISHU_APP_ID=<feishu-app-id>
FINANCECLAW_FEISHU_APP_SECRET=<secret-manager-reference>
FINANCECLAW_FEISHU_ALLOWED_OPEN_IDS='["ou_canary_user"]'
FINANCECLAW_FEISHU_SCOPES='["market:read","tools:read","artifacts:read","memory:read"]'
FINANCECLAW_FEISHU_MAX_CONCURRENCY=8
FINANCECLAW_FEISHU_SECURITY_MODE=strict

# DeepSeek V4 Pro 1M context: 800K planning ceiling, including output and input reserves.
FINANCECLAW_CONTEXT_INPUT_LIMIT=800000
FINANCECLAW_MODEL_MAX_TOKENS=32768
FINANCECLAW_MODEL_TIMEOUT_SECONDS=300
FINANCECLAW_CONTEXT_RESERVED_OUTPUT=32768
FINANCECLAW_CONTEXT_SYSTEM_POLICY_RESERVE=8192
FINANCECLAW_CONTEXT_TOOL_SCHEMA_RESERVE=32768
FINANCECLAW_CONTEXT_SAFETY_MARGIN=32768

# Stage 9：原生 state 摘要、工具结果归档和 Store 记忆。
FINANCECLAW_CONTEXT_RECENT_TURNS=4
FINANCECLAW_CONTEXT_SUMMARY_TRIGGER_TOKENS=64000
FINANCECLAW_CONTEXT_SOFT_INPUT_TOKENS=96000
FINANCECLAW_CONTEXT_TOOL_RESULTS_TO_KEEP=3
FINANCECLAW_SUMMARY_MAX_TOKENS=4096
FINANCECLAW_MEMORY_RECALL_TOKENS=4096
FINANCECLAW_MEMORY_RECALL_LIMIT=6
FINANCECLAW_MEMORY_AUTO_COMMIT_LOW_RISK_PREFERENCES=true
FINANCECLAW_ARTIFACT_RETENTION_DAYS=30
FINANCECLAW_EMBEDDING_DIMENSIONS=1536
FINANCECLAW_EMBEDDING_TIMEOUT_SECONDS=30
FINANCECLAW_HISTORY_INDEX_VERSION=history/1
FINANCECLAW_HISTORY_INDEX_BATCH_SIZE=4
FINANCECLAW_HISTORY_INDEX_POLL_SECONDS=5
# 按所选真实服务填写，并同步 langgraph*.json 中的 store.index.dims。
# FINANCECLAW_EMBEDDING_MODEL=provider-model
# FINANCECLAW_EMBEDDING_BASE_URL=https://provider.example/v1
# FINANCECLAW_EMBEDDING_API_KEY=provided-by-secret-manager
# FINANCECLAW_SUMMARY_MODEL=openai:summary-model
