# Overlay with the deployment profile and bff-run-control.env.example.
# Feishu BFF starts its sender automatically; this profile is for optional extra sender processes.
FINANCECLAW_NOTIFICATION_POLL_SECONDS=0.2
FINANCECLAW_NOTIFICATION_LEASE_SECONDS=60
FINANCECLAW_NOTIFICATION_TIMEOUT_SECONDS=10
FINANCECLAW_NOTIFICATION_MAX_FAILURES=5
# Keep 0 until the original-key recovery window has been verified against the real service.
FINANCECLAW_NOTIFICATION_VERIFIED_DEDUP_SECONDS=0
FINANCECLAW_NOTIFICATION_DEDUP_EVIDENCE=
# Inject the same app identity / current allowed user list as the Feishu BFF.
# The sender does not need a WebSocket, Agent credential or LangSmith credential.
FINANCECLAW_FEISHU_ENABLED=false
FINANCECLAW_FEISHU_APP_ID=
FINANCECLAW_FEISHU_APP_SECRET=
FINANCECLAW_FEISHU_ALLOWED_OPEN_IDS=[]
