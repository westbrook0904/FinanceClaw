{
  "definitions": {
    "BirthInput": {
      "additionalProperties": false,
      "description": "排盘所需出生资料；已知资料全部填写，未知字段留空，工具会一次列出需补充或确认的信息。",
      "properties": {
        "calendar": {
          "anyOf": [
            {
              "enum": [
                "solar",
                "lunar"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "出生日期的历法：solar=公历，lunar=农历；未知留空，不从日期样式猜测。"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalendarDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "出生年月日，按用户给出的历法填写，不能使用查询日期替代。"
        },
        "is_leap_month": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "农历月份是否闰月：true=闰月，false=明确非闰月；未知为 null，公历不填。"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/BirthPlace"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "出生地点与其时区，用于出生时间换算；不要用当前所在地替代。"
        },
        "sex_for_chart": {
          "anyOf": [
            {
              "enum": [
                "male",
                "female"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "排盘算法使用的性别：male=男，female=女；只采用用户提供的资料，不根据姓名猜测。"
        },
        "time": {
          "$ref": "#/$defs/BirthTime",
          "description": "出生时间或时辰，保留实际精度；用户没提供时不能补造 12:00 等默认时间。"
        },
        "time_basis": {
          "anyOf": [
            {
              "enum": [
                "civil",
                "apparent_solar"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "civil",
          "description": "出生记录时制：civil=当地民用钟表时间，apparent_solar=真太阳时。当前仅支持 civil；未明确时制时默认使用 civil。"
        }
      },
      "type": "object"
    },
    "BirthPlace": {
      "additionalProperties": false,
      "description": "只收地名和必要位置资料，不需要街道地址。",
      "properties": {
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选的两位国家或地区代码；需与出生地一致。"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选出生地纬度；当前民用时间排盘无需此字段，无需专门询问。"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "可选出生地经度；当前民用时间规则不使用它校正真太阳时，无需专门询问。"
        },
        "name": {
          "description": "出生地名称，例如上海。只需城市或地区，不需要街道地址。",
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "出生地 IANA 时区，例如 Asia/Shanghai。北京、上海、广州、深圳、成都、香港、台北可离线解析，其他地点需明确时区。"
        }
      },
      "type": "object"
    },
    "BirthTime": {
      "additionalProperties": false,
      "description": "保留实际时间精度；区间为同一民用日期内的闭区间。",
      "properties": {
        "clock": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "出生当地钟表时间 HH:MM；kind=clock 必填，range 时表示区间开始。"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "kind=range 时必填，同一出生日期内的区间结束时间 HH:MM，含结束分钟。"
        },
        "fold": {
          "anyOf": [
            {
              "enum": [
                0,
                1
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "夏令时回拨导致同一钟表时间出现两次时，0=第一次，1=第二次；不确定时留空。"
        },
        "kind": {
          "default": "unknown",
          "description": "clock=钟表时间；shichen=明确时辰；range=时间区间；不知道时用 unknown，禁止猜测。",
          "enum": [
            "clock",
            "shichen",
            "range",
            "unknown"
          ],
          "type": "string"
        },
        "shichen": {
          "anyOf": [
            {
              "enum": [
                "zi_early",
                "chou",
                "yin",
                "mao",
                "chen",
                "si",
                "wu",
                "wei",
                "shen",
                "you",
                "xu",
                "hai",
                "zi_late",
                "zi"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "kind=shichen 时填写：yin=寅时等；zi_early=00:00–00:59，zi_late=23:00–23:59。仅知道子时用 zi，需澄清早晚，不补造钟表时间。"
        }
      },
      "type": "object"
    },
    "CalendarDate": {
      "additionalProperties": false,
      "description": "不使用公历 date 校验农历，避免错误拒绝合法农历二月三十。",
      "properties": {
        "day": {
          "description": "出生日期中的日，不自行换算农历。",
          "maximum": 31,
          "minimum": 1,
          "type": "integer"
        },
        "month": {
          "description": "出生月份；农历闰月另填 birth.is_leap_month。",
          "maximum": 12,
          "minimum": 1,
          "type": "integer"
        },
        "year": {
          "description": "出生年份，按 birth.calendar 指定的历法填写。",
          "maximum": 2099,
          "minimum": 1901,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ZiweiDateRange": {
      "additionalProperties": false,
      "description": "显式公历区间，不用代表日期替代整段查询。",
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "结束公历日期 YYYY-MM-DD，不含当天；区间不超过 366 天。",
          "title": "End"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "起始公历日期 YYYY-MM-DD，包含当天。",
          "title": "Start"
        }
      },
      "title": "ZiweiDateRange",
      "type": "object"
    }
  },
  "common": {
    "birth": {
      "$ref": "#/$defs/BirthInput",
      "description": "结合用户原请求、clarifications 的问题与回答、授权引用，填写所有已知出生资料；不能因父 arguments 提示不完整而丢掉已有资料。"
    },
    "focus": {
      "default": "overall",
      "description": "overall=综合；career=事业；relationship=关系；wealth=财运。只影响展示主题，不改变完整命盘。",
      "enum": [
        "overall",
        "career",
        "relationship",
        "wealth"
      ],
      "type": "string"
    },
    "mode": {
      "default": "interpretation",
      "description": "chart_only=只给实际盘面；interpretation=盘面和自然语言解读。按用户要求选择。",
      "enum": [
        "chart_only",
        "interpretation"
      ],
      "type": "string"
    },
    "question": {
      "default": "",
      "description": "本次要回答的问题；可包含用户对当前对象的澄清补充，留空时沿用子任务目标。",
      "maxLength": 4000,
      "type": "string"
    },
    "subject_label": {
      "default": "本次排盘对象",
      "description": "当前排盘对象的展示标签，用于区分多人的问题；一个子任务只处理一个对象。",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    }
  },
  "targets": {
    "ziwei_daily_chart": {
      "date_range": {
        "anyOf": [
          {
            "$ref": "#/$defs/ZiweiDateRange"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "需要连续区间时填写 start/end；不与具体日期、年月或偏移量混用。"
      },
      "day_offset": {
        "anyOf": [
          {
            "maximum": 10,
            "minimum": -10,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "0=今天，1=明天，-1=昨天；按 time_context.request_clock 和查询时区解析。"
      },
      "on_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询此公历日期 YYYY-MM-DD 所在的盘面；不与期间或偏移量同时填写。"
      }
    },
    "ziwei_decadal_chart": {
      "date_range": {
        "anyOf": [
          {
            "$ref": "#/$defs/ZiweiDateRange"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "需要连续区间时填写 start/end；不与具体日期、年月或偏移量混用。"
      },
      "day_offset": {
        "anyOf": [
          {
            "maximum": 10,
            "minimum": -10,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询今天所在的大限填 0；按 time_context.request_clock 和查询时区定位，未知留空。"
      },
      "on_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询此公历日期 YYYY-MM-DD 所在的盘面；不与期间或偏移量同时填写。"
      }
    },
    "ziwei_monthly_chart": {
      "date_range": {
        "anyOf": [
          {
            "$ref": "#/$defs/ZiweiDateRange"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "需要连续区间时填写 start/end；不与具体日期、年月或偏移量混用。"
      },
      "month": {
        "anyOf": [
          {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询整个公历月份，与 year 一起填写；未知不猜测。"
      },
      "month_offset": {
        "anyOf": [
          {
            "maximum": 10,
            "minimum": -10,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "0=本月整月，1=下月，-1=上月；按 time_context.request_clock 和查询时区解析。"
      },
      "on_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询此公历日期 YYYY-MM-DD 所在的盘面；不与期间或偏移量同时填写。"
      },
      "year": {
        "anyOf": [
          {
            "maximum": 2099,
            "minimum": 1901,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "明确查询月份的公历年份，与 month 一起填写。"
      }
    },
    "ziwei_natal_chart": {},
    "ziwei_yearly_chart": {
      "date_range": {
        "anyOf": [
          {
            "$ref": "#/$defs/ZiweiDateRange"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "需要连续区间时填写 start/end；不与具体日期、年月或偏移量混用。"
      },
      "on_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询此公历日期 YYYY-MM-DD 所在的盘面；不与期间或偏移量同时填写。"
      },
      "year": {
        "anyOf": [
          {
            "maximum": 2099,
            "minimum": 1901,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "查询整个公历年份；今年或明年请改填 year_offset。"
      },
      "year_offset": {
        "anyOf": [
          {
            "maximum": 10,
            "minimum": -10,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "0=今年整年，1=明年，-1=去年；按 time_context.request_clock 和查询时区解析。"
      }
    }
  }
}
