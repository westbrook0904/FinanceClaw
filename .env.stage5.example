# Copy to .env.stage5 for a production-like deployment. Resolve all secrets
# from the deployment Secret Manager; never commit their values.
FINANCECLAW_ENVIRONMENT=production
FINANCECLAW_DEBUG_FULL_IO=false
FINANCECLAW_OFFLINE_MODEL=false
FINANCECLAW_MODEL=openai:deepseek-v4-pro
FINANCECLAW_PROVIDER_BASE_URL=https://api.deepseek.com
FINANCECLAW_PROVIDER_API_KEY=<secret-manager-reference>
FINANCECLAW_EGRESS_ALLOWED_HOSTS='["api.deepseek.com","id.example.com","api.smith.langchain.com","otel-collector.example.com"]'

FINANCECLAW_OIDC_ISSUER=https://id.example.com/
FINANCECLAW_OIDC_AUDIENCE=financeclaw-api
FINANCECLAW_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
FINANCECLAW_OIDC_ALGORITHMS='["RS256"]'
FINANCECLAW_OIDC_TENANT_CLAIM=tenant_id
FINANCECLAW_AGENT_SERVER_URL=http://agent-server:2024
FINANCECLAW_INTERNAL_SERVICE_HOSTS='["agent-server"]'
FINANCECLAW_AGENT_SERVER_SERVICE_TOKEN=<secret-manager-reference>

FINANCECLAW_DATABASE_URL=postgresql+psycopg://financeclaw:<secret>@app-db:5432/financeclaw_app
FINANCECLAW_DATABASE_AUTO_CREATE_SCHEMA=false
FINANCECLAW_ARTIFACT_BACKEND=s3
FINANCECLAW_ARTIFACT_S3_BUCKET=financeclaw-artifacts
FINANCECLAW_ARTIFACT_S3_PREFIX=production
FINANCECLAW_ARTIFACT_S3_ENDPOINT_URL=http://artifact-store:9000
FINANCECLAW_ARTIFACT_S3_REGION=us-east-1
FINANCECLAW_ARTIFACT_S3_SSE_ALGORITHM=AES256

FINANCECLAW_LANGSMITH_PROJECT=financeclaw-production
FINANCECLAW_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
FINANCECLAW_LANGSMITH_TRACE_SAMPLE_RATE=0.05
FINANCECLAW_LANGSMITH_HIDE_INPUTS=true
FINANCECLAW_LANGSMITH_HIDE_OUTPUTS=true
FINANCECLAW_OTEL_EXPORTER_ENDPOINT=https://otel-collector.example.com/v1/traces
FINANCECLAW_OTEL_METRICS_EXPORTER_ENDPOINT=https://otel-collector.example.com/v1/metrics
FINANCECLAW_OTEL_TRACE_SAMPLE_RATE=0.1
